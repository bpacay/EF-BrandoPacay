# Copia este archivo como .env y completa los valores.

# Puerto local (Render lo asigna automáticamente)
PORT=3000

# Cadena de conexión de Supabase (Project Settings -> Database -> Connection string).
# Codifica los caracteres especiales de la contraseña: % -> %25, @ -> %40, # -> %23, / -> %2F
# Si se deja vacía se usa data/estudiantes.json (solo local).
DATABASE_URL=postgresql://postgres.erxqoehlomcdppdecabk:tk_eyB29V%C!Pck%25@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Claves de reCAPTCHA v2 ("No soy un robot") de https://www.google.com/recaptcha/admin
# Si se dejan vacías se usan las claves de PRUEBA de Google (siempre aprueban).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Orígenes permitidos para consumir el API desde otro dominio, separados por coma. * = todos.
CORS_ORIGINS=*
